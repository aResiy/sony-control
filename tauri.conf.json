{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sony Control",
  "version": "1.1.1",
  "identifier": "local.sonycontrol",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sony Control",
        "width": 420,
        "height": 760,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
